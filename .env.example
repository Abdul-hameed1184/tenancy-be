# Copy to .env for local development. Never commit .env.

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- PostgreSQL ---
# DATABASE_URL takes precedence; the POSTGRES_* values are used by docker compose.
DATABASE_URL=postgres://pleet:pleet_dev_password@localhost:5433/pleet
DB_CONN_MAX_AGE=60
POSTGRES_DB=pleet
POSTGRES_USER=pleet
POSTGRES_PASSWORD=pleet_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://tenancy-fe.vercel.app

# --- JWT (Milestone 2) ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14

# --- Redis HA / Celery (Milestones 11-15) ---
# REDIS_SENTINELS=localhost:26379,localhost:26380,localhost:26381
# REDIS_MASTER_NAME=pleet-core
# CELERY_BROKER_URL=sentinel://localhost:26379;sentinel://localhost:26380;sentinel://localhost:26381
# CELERY_RESULT_BACKEND=sentinel://localhost:26379;sentinel://localhost:26380;sentinel://localhost:26381

# --- Image uploads (Cloudinary, direct from the browser) ---
# From the Cloudinary console dashboard. The secret only signs uploads server-side.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_ROOT_FOLDER=pleet
# CLOUDINARY_SIGNATURE_ALGORITHM=sha1

# --- Email verification ---
# EMAIL_VERIFICATION_TIMEOUT=259200

# --- Email (production) ---
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_TIMEOUT=10
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL=PLEET <no-reply@your-verified-domain.com>
# Configure SPF, DKIM and DMARC for the sender domain with your email provider.
